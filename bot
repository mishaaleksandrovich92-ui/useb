from telethon import TelegramClient, events, functions
from gtts import gTTS
import random, string, os, datetime, asyncio, requests

api_id = 27557328
api_hash = "7f7e062bcbec01fe3c02c7c898ce3cb7"

client = TelegramClient("kryin_session", api_id, api_hash)

PREFIX = "."
VERSION = "17.0 FINAL"
DEV = "@kryin"

copy_user = None
spam_task = None

def mono(text):
    return f"`{text}`"

# ===== HELP =====
HELP_TEXT = f"""⚡ Kryin UserBot ⚡

👑 Версия: {VERSION}
🤖 Разраб: {DEV}

📌 ОСНОВА
• {mono(".ping")} • {mono(".id")}

🌍 ВРЕМЯ
• {mono(".time город")} • {mono(".timeoff")} • {mono(".timelist")}

📊 УТИЛИТЫ
• {mono(".calc")} • {mono(".delme")}

🧠 ГЕНЕРАТОР
• {mono(".genpass")}

🔊 МЕДИА
• {mono(".tts")}

👤 ПРОФИЛЬ
• {mono(".clone")} • {mono(".back")}

🔥 ФАН
